<Page
    x:Class="NexusApp.Gallery.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NexusApp.Gallery.Views"
    xmlns:catalog="using:NexusApp.Gallery"
    xmlns:controls="using:Ether.DesignSystem.Controls"
    Background="{ThemeResource BackgroundCanvas}">

    <!--
        The full component index, grouped by category, generated from ComponentCatalog —
        so this page and the NavigationView pane (built in MainWindow.xaml.cs) can never
        drift apart. Deliberately clickable text cards, no thumbnails.
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24" Spacing="24">

            <StackPanel Spacing="4">
                <TextBlock x:Uid="GalleryViewsHomePage007" Text="Nexus Component Gallery"
                           FontFamily="{StaticResource InstrumentSans}"
                           FontSize="32" FontWeight="SemiBold"
                           Foreground="{ThemeResource text/primary}"/>
                <TextBlock x:Uid="GalleryViewsHomePage008" Text="Every Nexus component, grouped by category. Click a card to open its page."
                           FontFamily="{StaticResource RobotoFont}"
                           FontSize="14"
                           Foreground="{ThemeResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <ItemsRepeater ItemsSource="{x:Bind Sections}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Vertical" Spacing="24"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="local:HomeSection">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{x:Bind Header}"
                                       Style="{StaticResource micro/semibold}"
                                       CharacterSpacing="80"
                                       Foreground="{ThemeResource TextTertiary}"/>
                            <ItemsRepeater ItemsSource="{x:Bind Items}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout Orientation="Horizontal"
                                                        MinItemWidth="200" MinItemHeight="60"
                                                        MinRowSpacing="12" MinColumnSpacing="12"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="catalog:ComponentEntry">
                                        <Button Tag="{x:Bind Mode=OneTime}"
                                                Click="Card_Click"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Padding="16,12"
                                                CornerRadius="{StaticResource radius/control}"
                                                Background="{ThemeResource background/surface}"
                                                BorderBrush="{ThemeResource BorderSubtle}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{x:Bind DisplayName}"
                                                           FontFamily="{StaticResource InstrumentSans}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{ThemeResource text/primary}"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                                    <controls:UpdatedBadge VerticalAlignment="Center"
                                                                           Visibility="{x:Bind IsUpdated, Converter={StaticResource BoolToVisibility}}"/>
                                                    <controls:PrimitiveBadge VerticalAlignment="Center"
                                                                             Visibility="{x:Bind IsPrimitive, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Height="24"/>

        </StackPanel>
    </ScrollViewer>
</Page>
