<Application
    x:Class="NexusApp.Gallery.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NexusApp.Gallery.Converters"
    xmlns:controls="using:Ether.DesignSystem.Controls">

    <Application.Resources>
        <ResourceDictionary>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <ResourceDictionary.MergedDictionaries>
                <!-- Unpackaged WinUI 3 apps explicitly merge framework control resources. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--
                    Ether design-system entry point — same as EDGNexusApp.csproj: loads
                    Foundation tokens + all Ether control templates (EtherButton,
                    EtherCheckbox, ...).
                -->
                <ResourceDictionary Source="ms-appx:///Ether.DesignSystem.Controls/Themes/DesignSystem.xaml" />
                <!--
                    Nexus app-level resource shell (Generic.xaml), linked in from
                    src\Themes\Generic.xaml — the same file EDGNexusApp merges. Keeps the
                    Gallery resolving the exact same Nexus-only keys (EtherLabel,
                    EtherDeviceTitle, data-graphics styles) that a real Nexus control could
                    depend on inside the app, so nothing works in the app but breaks here.
                -->
                <ResourceDictionary Source="ms-appx:///Generic.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
