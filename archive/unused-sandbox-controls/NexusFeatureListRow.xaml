<!--
    NexusFeatureListRow.xaml — Nexus Pattern — Feature category tile

    One tappable category tile in the right-hand feature panel: an icon, a
    label, and a trailing chevron. Tapping drills into that category's
    configuration (feature-detail state).

    FIXED: card surface, radius, chevron.
    DYNAMIC: Glyph (category icon) + Label (category name), per device.

    Figma: 3IJ6irh4mxZxunV5PpV3Ik node 502:4395 (white card, radius 12).
-->
<UserControl
    x:Class="NexusApp.Controls.NexusFeatureListRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MinHeight="80" is the Figma design-spec tile height for this pattern -->
    <Border Background="{ThemeResource BackgroundSurface}"
            BorderBrush="{ThemeResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusSurface}"
            Padding="{StaticResource PaddingSm}"
            MinHeight="80">
        <Grid ColumnSpacing="{StaticResource SpaceXs}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <FontIcon x:Name="FeatureIcon"
                      Grid.Column="0"
                      Glyph="&#xE707;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="18"
                      Foreground="{ThemeResource IconPrimary}"
                      VerticalAlignment="Center"/>

            <TextBlock x:Name="FeatureLabel"
                       Grid.Column="1"
                       Text="Feature name"
                       Style="{StaticResource EtherH5}"
                       Foreground="{ThemeResource TextPrimary}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <FontIcon Grid.Column="2"
                      Glyph="&#xE76C;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="14"
                      Foreground="{ThemeResource IconTertiary}"
                      VerticalAlignment="Center"/>
        </Grid>
    </Border>
</UserControl>
