<!--
    NexusDeviceHeader.xaml — Nexus Pattern — Device identity block

    FIXED LAYOUT: back chevron + device title, then model string + info icon.
    DYNAMIC: DeviceName, ModelText (set per device).

    Figma: 3IJ6irh4mxZxunV5PpV3Ik node 502:4537
      Title  → Instrument Sans, ~48px  → EtherDisplay48
      Model  → Inter 14, 70% black     → EtherBodyMRegular / TextSecondary
-->
<UserControl
    x:Class="NexusApp.Controls.NexusDeviceHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- SpaceMd (16px) gap between title row and model row per Figma spec -->
    <StackPanel Spacing="{StaticResource SpaceMd}">

        <!-- Row 1: back chevron + device title -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceMd}" VerticalAlignment="Center">
            <!-- 40×40 hit target per Figma spec -->
            <Button x:Name="BackButton"
                    Background="Transparent"
                    BorderThickness="0"
                    Width="40" Height="40" Padding="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE76B;"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="20"
                          Foreground="{ThemeResource IconPrimary}"/>
            </Button>
            <TextBlock x:Name="TitleText"
                       Text="Dell Peripherals name"
                       Style="{StaticResource EtherDisplay48}"
                       Foreground="{ThemeResource TextPrimary}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Row 2: model string + info icon -->
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource SpaceXs}" VerticalAlignment="Center">
            <TextBlock x:Name="ModelTextBlock"
                       Text="Peripherals model"
                       Style="{StaticResource EtherBodyMRegular}"
                       Foreground="{ThemeResource TextSecondary}"
                       VerticalAlignment="Center"/>
            <FontIcon Glyph="&#xE946;"
                      FontFamily="Segoe Fluent Icons"
                      FontSize="16"
                      Foreground="{ThemeResource IconTertiary}"
                      VerticalAlignment="Center"/>
        </StackPanel>
    </StackPanel>
</UserControl>
